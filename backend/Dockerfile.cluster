FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY backend/eMilimo.sln backend/
COPY backend/eMilimo.API/*.csproj backend/eMilimo.API/
COPY backend/eMilimo.Core/*.csproj backend/eMilimo.Core/
COPY backend/eMilimo.Infrastructure/*.csproj backend/eMilimo.Infrastructure/
COPY frontend/web/public/images/ucz-logo.png frontend/web/public/images/ucz-logo.png
RUN dotnet restore backend/eMilimo.sln
COPY backend backend
RUN dotnet publish backend/eMilimo.API/eMilimo.API.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
RUN mkdir -p /app/shared-data/uploads
EXPOSE 5001
ENTRYPOINT ["dotnet", "eMilimo.API.dll"]
