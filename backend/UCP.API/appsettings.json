{
  "Database": {
    "Provider": "PostgreSQL"
},
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ucp_db;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "YourSuperSecretKeyHereAtLeast32CharactersLong!"
  },
  "Security": {
    "Session": {
      "LifetimeMinutes": 30,
      "IdleTimeoutMinutes": 5,
      "WarningCountdownSeconds": 60
    },
    "PasswordPolicy": {
      "MinimumLength": 8,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireSpecialCharacter": true
    }
  },
  "Frontend": {
    "Url": "http://localhost:3001"
  },
  "FileStorage": {
    "BasePath": "uploads",
    "ContributionSubfolder": "contributions",
    "RequisitionSubfolder": "requisitions"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
