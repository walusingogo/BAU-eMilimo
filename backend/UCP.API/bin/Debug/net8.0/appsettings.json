{
  "Platform": {
    "Product": "UCP",
    "ApplicationName": "BAU.BusinessPlatform",
    "Instance": "trinity",
    "DeploymentId": "",
    "SharedDataPath": "shared-data",
    "Modules": [
      {
        "Key": "dashboard", "Name": "Dashboard", "Description": "Cross-module operational overview", "Route": "/dashboard", "Order": 10, "Enabled": true, "Dependencies": [],
        "Capabilities": [{ "Key": "view", "Name": "View dashboard", "Permission": "dashboard.view" }]
      },
      {
        "Key": "contributions", "Name": "Contributions", "Description": "Contribution capture, allocation and approval", "Route": "/contributions", "Order": 20, "Enabled": true, "Dependencies": ["identity", "organizations"],
        "Capabilities": [{ "Key": "create", "Name": "Create contribution", "Permission": "contributions.create" }, { "Key": "approve", "Name": "Approve contribution", "Permission": "contributions.approve" }, { "Key": "report", "Name": "Contribution reports", "Permission": "contributions.report" }]
      },
      {
        "Key": "requisitions", "Name": "Requisitions", "Description": "Requisition workflow and disbursement", "Route": "/requisitions", "Order": 30, "Enabled": true, "Dependencies": ["identity", "organizations"],
        "Capabilities": [{ "Key": "create", "Name": "Create requisition", "Permission": "requisitions.create" }, { "Key": "approve", "Name": "Approve requisition", "Permission": "requisitions.approve" }, { "Key": "report", "Name": "Requisition reports", "Permission": "requisitions.report" }]
      },
      {
        "Key": "assets", "Name": "Assets and Fleet", "Description": "Asset register, checkout and return workflows", "Route": "/assets", "Order": 40, "Enabled": true, "Dependencies": ["identity", "organizations"],
        "Capabilities": [{ "Key": "request", "Name": "Request asset", "Permission": "assets.request" }, { "Key": "approve", "Name": "Approve asset request", "Permission": "assets.approve" }, { "Key": "register", "Name": "Register asset", "Permission": "assets.register" }]
      },
      {
        "Key": "reports", "Name": "Reports", "Description": "Cross-module reporting and exports", "Route": "/reports", "Order": 50, "Enabled": true, "Dependencies": [],
        "Capabilities": [{ "Key": "view", "Name": "View reports", "Permission": "reports.view" }]
      },
      {
        "Key": "administration", "Name": "Administration", "Description": "Identity, permissions, configuration and operations", "Route": "/administration", "Order": 90, "Enabled": true, "Dependencies": ["identity"],
        "Capabilities": [{ "Key": "manage", "Name": "Manage platform", "Permission": "administration.manage" }]
      }
    ]
  },
  "Database": {
    "Provider": "PostgreSQL"
},
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379,abortConnect=false,connectTimeout=5000,syncTimeout=5000",
    "InstanceName": "ucp:trinity:",
    "DefaultTtlMinutes": 15
  },
  "Setup": {
    "BootstrapToken": ""
  },
  "Identity": {
    "MembershipIdPatterns": {
      "Default": "TRI{0000}",
      "SuperAdmin": "SUPER{0000}",
      "Admin": "ADM{0000}",
      "Auditor": "AUD{0000}",
      "Accountant": "ACC{0000}",
      "Treasurer": "TRS{0000}",
      "Secretary": "SEC{0000}",
      "Minister": "MIN{0000}",
      "ChurchAuth": "CAU{0000}",
      "SeniorRep": "SRP{0000}",
      "GroupRep": "GRP{0000}"
    }
  },
  "Jwt": {
    "Secret": ""
  },
  "Security": {
    "Session": {
      "LifetimeMinutes": 30,
      "IdleTimeoutMinutes": 10,
      "WarningCountdownSeconds": 60
    },
    "PasswordPolicy": {
      "MinimumLength": 8,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireSpecialCharacter": true
    }
  },
  "Frontend": {
    "Url": "http://192.168.1.178:4200"
  },
  "License": {
    "IdentityMode": "Machine",
    "AllowLegacyLicenses": false,
    "ContactEmail": "info@bausolutions.africa",
    "ContactPhone": "+260 979 668 763"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://192.168.1.178:4200",
      "http://localhost:4200"
    ]
  },
  "Smtp": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "Church Staff Platform",
    "TimeoutMilliseconds": 30000
  },
  "FileStorage": {
    "Provider": "FileSystem",
    "SharedRoot": "wwwroot",
    "BasePath": "uploads",
    "ContributionSubfolder": "contributions",
    "RequisitionSubfolder": "requisitions"
  },
  "Backup": {
    "PostgreSqlDumpPath": "pg_dump",
    "PostgreSqlRestorePath": "pg_restore"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
