<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="bau-platform-local" value="..\BAU.Platform\artifacts\packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="bau-platform-local">
      <package pattern="BAU.Platform.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
